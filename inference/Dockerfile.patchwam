# syntax=docker/dockerfile:1
# Isolated PatchWAM image for Jetson AGX Thor. Does not install or modify GR00T.
ARG BASE_IMAGE=nvidia/cuda:13.0.0-runtime-ubuntu24.04
FROM ${BASE_IMAGE}
ARG TARGETARCH
ARG PATCHWAM_REF=7783ae2447ef26c10b2b0470753dfad6be85202e
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH PYTHONPATH=/app \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    HF_HOME=/cache/huggingface REPO_ROOT=/opt/PatchWAM
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN test "${TARGETARCH:-$(dpkg --print-architecture)}" = arm64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git python3 python3-dev \
        python3-venv build-essential libglib2.0-0 libgomp1 ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv \
    && python -m pip install --upgrade pip setuptools wheel
RUN python -m pip install torch==2.9.1 torchvision==0.24.1 \
        --index-url https://download.pytorch.org/whl/cu130 \
    && mkdir -p /opt/build-info \
    && python -c 'from importlib.metadata import version; print("torch=="+version("torch")); print("torchvision=="+version("torchvision"))' > /opt/build-info/torch-constraints.txt
ENV PIP_CONSTRAINT=/opt/build-info/torch-constraints.txt
COPY inference/requirements.patchwam.txt /opt/setup/requirements.patchwam.txt
RUN python -m pip install -r /opt/setup/requirements.patchwam.txt \
    && git init /opt/PatchWAM \
    && git -C /opt/PatchWAM remote add origin https://github.com/TianhengW/PatchWAM-RoboCasa.git \
    && git -C /opt/PatchWAM fetch --depth 1 origin "${PATCHWAM_REF}" \
    && git -C /opt/PatchWAM checkout --detach FETCH_HEAD \
    && git -C /opt/PatchWAM rev-parse HEAD > /opt/build-info/patchwam.commit \
    && python -m pip install --no-deps -e /opt/PatchWAM \
    && python -m pip check \
    && python -m pip freeze > /opt/build-info/pip-freeze.txt
COPY core /app/core
COPY inference /app/inference
COPY tests /app/tests
COPY sim /app/sim
RUN python -c 'from inference.serve_patchwam import upstream_policy_class; print(upstream_policy_class("/opt/PatchWAM").__name__)'
WORKDIR /app
EXPOSE 8000
HEALTHCHECK --start-period=600s --interval=10s --timeout=5s --retries=3 \
    CMD python -c 'from urllib.request import urlopen; urlopen("http://127.0.0.1:8000/health", timeout=3)'
CMD ["python", "-m", "inference.serve_patchwam"]
