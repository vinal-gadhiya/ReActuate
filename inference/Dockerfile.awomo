# syntax=docker/dockerfile:1
ARG BASE_IMAGE=nvidia/cuda:13.0.0-runtime-ubuntu24.04
FROM ${BASE_IMAGE}
ARG TARGETARCH
ARG AWOMO_REF=b11d82f7ee198955d0e9d26b3ebeed1dafea03b4
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH PYTHONPATH=/app \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    HF_HOME=/cache/huggingface IMAGEIO_FFMPEG_EXE=/usr/bin/ffmpeg
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN test "${TARGETARCH:-$(dpkg --print-architecture)}" = arm64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git python3 python3-dev \
       python3-venv build-essential libglib2.0-0 libgomp1 ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv \
    && python -m pip install --upgrade pip setuptools wheel
RUN python -m pip install torch==2.9.1 torchvision==0.24.1 --index-url https://download.pytorch.org/whl/cu130 \
    && mkdir -p /opt/build-info \
    && python -c 'from importlib.metadata import version; print("torch=="+version("torch")); print("torchvision=="+version("torchvision"))' > /opt/build-info/torch-constraints.txt
ENV PIP_CONSTRAINT=/opt/build-info/torch-constraints.txt
COPY inference/requirements.awomo.txt /opt/setup/requirements.awomo.txt
COPY inference/repair_cuda_metadata.py /opt/setup/repair_cuda_metadata.py
RUN python -m pip install -r /opt/setup/requirements.awomo.txt \
    && git init /opt/Awomo \
    && git -C /opt/Awomo remote add origin https://github.com/Awomo-WestlakeDI/Awomo-0.5.git \
    && git -C /opt/Awomo fetch --depth 1 origin "${AWOMO_REF}" \
    && git -C /opt/Awomo checkout --detach FETCH_HEAD \
    && git -C /opt/Awomo rev-parse HEAD > /opt/build-info/awomo.commit \
    && python /opt/setup/repair_cuda_metadata.py \
    && python -m pip check \
    && python -m pip freeze > /opt/build-info/pip-freeze.txt
COPY core /app/core
COPY inference /app/inference
COPY sim /app/sim
COPY tests /app/tests
WORKDIR /app
RUN PYTHONPATH=/app:/opt/Awomo python -c 'from eval_robocasa365.awomo_05i.policy import load_policy; print(load_policy.__name__)'
EXPOSE 8000
HEALTHCHECK --start-period=900s --interval=10s --timeout=5s --retries=3 \
    CMD python -c 'from urllib.request import urlopen; urlopen("http://127.0.0.1:8000/health", timeout=3)'
CMD ["python", "-m", "inference.serve_awomo"]
