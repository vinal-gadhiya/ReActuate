# syntax=docker/dockerfile:1
# API-based planning and its tests do not need CUDA, torch, or GR00T weights.
FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir numpy==1.26.4 Pillow==11.1.0
WORKDIR /app
COPY core /app/core
COPY inference /app/inference
COPY sim /app/sim
COPY tests /app/tests
EXPOSE 8001
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD python -c 'from urllib.request import urlopen; urlopen("http://127.0.0.1:8001/health", timeout=3)'
CMD ["python", "-m", "inference.supervisor"]
